{
  "name": "@matrixhr/agent",
  "version": "0.1.0",
  "private": true,
  "description": "MatrixHR work-activity agent (disclosed). Records time and activity only — never keystrokes, screen or content.",
  "main": "dist/electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start:headless": "tsx src/headless.ts run",
    "pair": "tsx src/headless.ts pair",
    "test": "node --import tsx --test test/*.test.ts",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "tsx": "^4.22.4"
  },
  "comment:optionalDependencies": "Installed on the dev/build machine. The core loads these dynamically; headless core + tests run without them.",
  "optionalDependencies": {
    "active-win": "^8.2.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3",
    "@types/node": "^20.14.0"
  },
  "build": {
    "appId": "com.matrixhr.agent",
    "productName": "MatrixHR Activity Agent",
    "files": ["dist/**", "electron/onboarding.html", "assets/**"],
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true },
    "mac": { "target": ["dmg"], "icon": "assets/icon.icns", "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage"], "icon": "assets/icon.png", "category": "Utility" }
  }
}
