{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "typeRoots": [
      "../../node_modules/.pnpm/@types+node@22.19.20/node_modules/@types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "electron/**/*.ts",
    "test/**/*.ts"
  ]
}
