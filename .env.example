# Database
DATABASE_URL="postgresql://matrixhr:matrixhr@localhost:5432/matrixhr?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production-use-32-chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
APP_DOMAIN="localhost"

# Storage (MinIO dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="matrixhr"
S3_SECRET_KEY="matrixhrsecret"
S3_BUCKET="matrixhr"
S3_REGION="us-east-1"

# Email — password reset links. Without SMTP_URL, dev keeps mail in an outbox (GET /dev/outbox);
# production logs that mail was NOT delivered.
SMTP_URL=""            # e.g. smtps://user:pass@smtp.example.com
MAIL_FROM="MatrixHR <no-reply@example.com>"

# WhatsApp (optional in dev). The webhook is refused (503) unless APP_SECRET is set.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""     # Meta app secret: verifies X-Hub-Signature-256 on inbound webhooks
WHATSAPP_VERIFY_TOKEN=""   # your own string, entered in Meta's webhook setup
DEFAULT_TENANT_ID=""       # single-tenant deployments: tenant that owns WHATSAPP_PHONE_NUMBER_ID

# Security (see docs/DEPLOYMENT.md). Production REFUSES to start with dev defaults for these.
CREDENTIAL_KEY="generate-a-random-32+-char-value"   # encrypts integration tokens + webhook secrets
TRUST_PROXY=""             # behind a load balancer: hop count (1) or subnet — needed for correct per-IP rate limits
ENABLE_API_DOCS=""         # "true" re-enables Swagger in production
# WEBHOOK_ALLOW_PRIVATE_TARGETS, THROTTLE_LIMIT, AUTH_THROTTLE_LIMIT are dev/test-only — never set in production.

# Google Gemini (Ask MatrixHR AI page)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# White-label (reseller) mode. Leave all of these empty for the standard MatrixHR product.
# Setting WL_PRODUCT_NAME turns it on: that name, logo, colour and support address replace the vendor's everywhere
# a client sees (web app, sign-in, emails, payslip PDFs, page titles, mobile app config, the AI assistant).
# See docs/DEPLOYMENT.md "White-label and multi-client hosting".
WL_PRODUCT_NAME=""
WL_LOGO_URL=""
WL_FAVICON_URL=""
WL_PRIMARY_COLOR=""        # #RRGGBB
WL_SUPPORT_EMAIL=""
WL_EMAIL_FROM_NAME=""      # defaults to WL_PRODUCT_NAME
WL_WEBSITE_URL=""          # https://app.reseller.com
WL_LEGAL_TEXT=""           # optional line printed under the issuer name on receipts
